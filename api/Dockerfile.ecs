# ECS image: Cloud Map upstreams (api/nginx.ecs.conf).
# Local Compose keeps using api/Dockerfile + nginx.conf.
# Single-EC2 Compose keeps using api/Dockerfile.prod + nginx.prod.conf.
FROM nginx:1.27-alpine

COPY api/nginx.ecs.conf /etc/nginx/conf.d/default.conf
# Shared route table and upstream names, included by the config above.
COPY api/gateway/*.conf /etc/nginx/dupli1/

EXPOSE 80 443
